<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility: allow querying all launchable apps (App Lock scanner) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <!-- AdMob App ID (ADS-001) — replace with production ID before release -->
      <meta-data
          android:name="com.google.android.gms.ads.APPLICATION_ID"
          android:value="ca-app-pub-3940256099942544~3347511713" />
      <!-- Delay ad measurement init to avoid cold-start impact -->
      <meta-data
          android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
          android:value="true" />
      <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
              android:name="android.support.FILE_PROVIDER_PATHS"
              android:resource="@xml/file_paths" />
      </provider>
      <!-- MainActivity — no longer has LAUNCHER intent directly.
           The launcher entry is handled by MainActivityAlias below,
           which can be disabled for stealth mode. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/SplashTheme"
        android:screenOrientation="portrait"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
      </activity>

      <!-- Disguised launcher aliases — only one enabled at a time.
           AppIconModule switches between them. StealthModule disables all. -->
      <activity-alias
        android:name=".alias.DefaultAlias"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:exported="true"
        android:enabled="false">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".alias.CalculatorAlias"
        android:targetActivity=".MainActivity"
        android:label="Calculator"
        android:icon="@mipmap/ic_calculator"
        android:roundIcon="@mipmap/ic_calculator_round"
        android:exported="true"
        android:enabled="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".alias.WeatherAlias"
        android:targetActivity=".MainActivity"
        android:label="Weather"
        android:icon="@mipmap/ic_weather"
        android:roundIcon="@mipmap/ic_weather_round"
        android:exported="true"
        android:enabled="false">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".alias.NotesAlias"
        android:targetActivity=".MainActivity"
        android:label="Notes"
        android:icon="@mipmap/ic_notes"
        android:roundIcon="@mipmap/ic_notes_round"
        android:exported="true"
        android:enabled="false">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <!-- Fake Crash Screen — translucent activity mimicking system crash dialog -->
      <activity
          android:name=".modules.fakecrash.FakeCrashActivity"
          android:theme="@style/FakeCrashTheme"
          android:exported="false"
          android:excludeFromRecents="true"
          android:taskAffinity=""
          android:launchMode="singleTop" />

      <!-- Device Admin receiver for uninstall protection -->
      <receiver
          android:name=".modules.uninstallprotect.VaultDeviceAdminReceiver"
          android:permission="android.permission.BIND_DEVICE_ADMIN"
          android:exported="true">
          <intent-filter>
              <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
          </intent-filter>
          <meta-data
              android:name="android.app.device_admin"
              android:resource="@xml/device_admin_policies" />
      </receiver>

      <!-- Secret dialer code receiver — dial *#*#9876#*#* to launch
           VaultCalc when the icon is hidden in stealth mode. -->
      <receiver
          android:name=".modules.stealth.SecretCodeReceiver"
          android:exported="true">
          <intent-filter>
              <action android:name="android.provider.Telephony.SECRET_CODE" />
              <data android:scheme="android_secret_code"
                    android:host="9876" />
          </intent-filter>
      </receiver>
      <receiver
          android:name=".widget.CalculatorWidgetProvider"
          android:exported="true"
          android:label="Calculator">
          <intent-filter>
              <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <meta-data
              android:name="android.appwidget.provider"
              android:resource="@xml/calculator_widget_info" />
      </receiver>

      <!-- App Lock Accessibility Service -->
      <service
          android:name=".modules.applock.AppLockAccessibilityService"
          android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
          android:exported="false">
          <intent-filter>
              <action android:name="android.accessibilityservice.AccessibilityService" />
          </intent-filter>
          <meta-data
              android:name="android.accessibilityservice"
              android:resource="@xml/applock_accessibility_config" />
      </service>

      <!-- App Lock Screen Activity -->
      <activity
          android:name=".modules.applock.LockScreenActivity"
          android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
          android:exported="false"
          android:excludeFromRecents="true"
          android:launchMode="singleTop"
          android:taskAffinity="" />

      <!-- Notification Privacy Listener Service -->
      <service
          android:name=".modules.notificationprivacy.NotificationPrivacyListener"
          android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
          android:exported="false">
          <intent-filter>
              <action android:name="android.service.notification.NotificationListenerService" />
          </intent-filter>
      </service>
    </application>
</manifest>
