<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Centered crash dialog card -->
    <LinearLayout
        android:id="@+id/dialogCard"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_crash_dialog"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:elevation="24dp">

        <!-- Crash message -->
        <TextView
            android:id="@+id/tvCrashMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VaultCalc keeps stopping"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E2E"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp" />

        <!-- Button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <!-- App info button -->
            <TextView
                android:id="@+id/btnAppInfo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="App info"
                android:textColor="#AECBFA"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <!-- Close app button -->
            <TextView
                android:id="@+id/btnCloseApp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Close app"
                android:textColor="#AECBFA"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <!-- Send feedback button -->
            <TextView
                android:id="@+id/btnSendFeedback"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Send feedback"
                android:textColor="#AECBFA"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
