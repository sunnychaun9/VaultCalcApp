<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Display -->
    <TextView
        android:id="@+id/widget_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="@drawable/widget_display_bg"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:padding="12dp"
        android:text="0"
        android:textColor="@color/widget_display_text"
        android:textSize="28sp" />

    <!-- Row 1: AC ⌫ % ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="AC"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="⌫"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_percent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_function"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="%"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_divide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_operator"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="÷"
            android:textColor="@color/widget_btn_text_operator"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Row 2: 7 8 9 × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="7"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="8"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="9"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_multiply"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_operator"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="×"
            android:textColor="@color/widget_btn_text_operator"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Row 3: 4 5 6 − -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="4"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="5"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="6"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_subtract"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_operator"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="−"
            android:textColor="@color/widget_btn_text_operator"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Row 4: 1 2 3 + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="1"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="2"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="3"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_operator"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="+"
            android:textColor="@color/widget_btn_text_operator"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Row 5: 0 (wide) . = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="2"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="0"
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_decimal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_number"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="."
            android:textColor="@color/widget_btn_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_equals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_equals"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="="
            android:textColor="@color/widget_btn_text_equals"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
