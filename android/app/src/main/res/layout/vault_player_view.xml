<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Media3 PlayerView used by VaultVideoPlayerView.
  Forces surface_type="texture_view" so gesture overlays (volume/brightness
  sliders, center indicator) render correctly on top of the video.
  SurfaceView (the default) punches through the view compositor and
  obscures sibling overlays even when they have elevation > 0.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:use_controller="false"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:show_buffering="never" />
